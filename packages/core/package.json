{
  "name": "@previz/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Previz Spec schema, compiler, deterministic evaluator and script builder (headless, no DOM).",
  "exports": {
    ".": "./src/index.ts",
    "./examples/*": "./examples/*"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:schema": "tsx scripts/gen-schema.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
